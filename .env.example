PORT=3333
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
DOWNLOADS_DIR=./downloads
MAX_STORAGE_MB=256
YTDLP_BIN=yt-dlp
# Optional HTTP(S) or SOCKS5 proxy used ONLY for YouTube yt-dlp calls (never logged or returned by API):
# Example: http://<PROXY_USER>:<PROXY_PASS>@<PROXY_HOST>:<PROXY_PORT>
YTDLP_PROXY=
FFMPEG_BIN=ffmpeg
# Set only on Vercel to proxy /api/* requests to your VPS backend without exposing the VPS IP:
VPS_BACKEND_URL=
